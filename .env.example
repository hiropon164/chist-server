# Copy to .env and fill in. .env is git-ignored; keep it at 0600.

# Shared token authenticating `chist push` on each machine against the server.
# Generate with: openssl rand -hex 32
# The server refuses to start without it, rather than serve history unauthenticated.
CHIST_TOKEN=

# Public hostname. Traefik routes on this Host.
CHIST_HOST=chist.example.com

# Allowed source CIDRs, comma separated.
# With wildcard DNS and hairpin NAT, LAN traffic can arrive as the router's external
# IP. Include that public address too when that is the case.
CHIST_ALLOW=192.168.1.0/24

# basicauth for the web UI: browsers cannot send a bearer token.
# Generate with: docker run --rm httpd:2-alpine htpasswd -nbB <user> <pass>
# Paste the output verbatim — no $ escaping is needed inside .env.
CHIST_BASICAUTH=

# Name of the docker network the existing Traefik is on (see: docker network ls)
CHIST_NETWORK=traefik

# Traefik entrypoint and certificate resolver.
# To serve plain HTTP, remove the tls.certresolver label from docker-compose.yml.
CHIST_ENTRYPOINT=websecure
CHIST_CERTRESOLVER=letsencrypt

# Container timezone
TZ=UTC
