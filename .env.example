# cp .env.example .env して埋める。.env は git 管理外（0600 推奨）。

# 各マシンの `chist push` とサーバを認証する共有トークン。
# 生成:  openssl rand -hex 32
# 未設定だとサーバは起動を拒否する（履歴を無認証で公開しないため）。
CHIST_TOKEN=

# 公開ホスト名。Traefik がこの Host でルーティングする。
CHIST_HOST=chist.example.com

# 到達を許可する送信元 CIDR（カンマ区切り）。
# ワイルドカード DNS + ヘアピン NAT の環境では、LAN からのアクセスがルータの
# 外側 IP として届くことがある。その場合はそのグローバル IP も含める。
CHIST_ALLOW=192.168.1.0/24

# Web UI の basicauth。ブラウザは bearer token を送れないためこちらで守る。
# 生成:  docker run --rm httpd:2-alpine htpasswd -nbB <user> <pass>
# .env の中では $ のエスケープは不要（出力をそのまま貼る）。
CHIST_BASICAUTH=

# 既存 Traefik が参加している docker network 名（docker network ls で確認）
CHIST_NETWORK=traefik

# Traefik の entrypoint と証明書リゾルバ。
# 平文 HTTP で動かす場合は docker-compose.yml の tls.certresolver ラベルを外すこと。
CHIST_ENTRYPOINT=websecure
CHIST_CERTRESOLVER=letsencrypt

# コンテナのタイムゾーン
TZ=UTC
